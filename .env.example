# Resend — contact form email delivery
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender shown to recipients. While your domain is unverified,
# leave this as onboarding@resend.dev (Resend's sandbox sender). A display
# name (MANATO Entertainments <address>) is applied automatically unless
# MAIL_FROM already contains one.
MAIL_FROM=onboarding@resend.dev

# Inbox that receives the enquiry notification. Optional override for test
# routing; falls back to site.email in lib/content.ts.
MAIL_TO=hello@manatoentertainments.com
